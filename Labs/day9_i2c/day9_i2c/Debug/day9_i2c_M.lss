00000314 <I2C_InitMaster>:
	// 7-bit slave address shifted left, R/W bit = 1 (Read)
	TWDR_Reg = (slave_address << 1) | 0x01;
	
	TWCR_Reg = (1 << TWINT) | (1 << TWEN);
	while (READ_BIT(TWCR_Reg, TWINT) == 0);
}
